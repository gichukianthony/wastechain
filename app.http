########################################  AUTH TESTING ENDPOINTS   ###########################################################

### Login (email + password) -> JWT
POST {{baseUrl}}{{authPath}}/login
Content-Type: application/json

{
  "email": "antonygatitu327@gmail.com",
  "password": "ChangeMe123!"
}

### Google OAuth Login (id_token -> JWT)
POST {{baseUrl}}{{authPath}}/google
Content-Type: application/json

{
  "idToken": "GOOGLE_ID_TOKEN"
}

### Request OTP for phone login (WhatsApp)
POST {{baseUrl}}{{authPath}}/otp/request
Content-Type: application/json

{
  "phone": "+254721227443"
}

### Verify OTP and get JWT
POST {{baseUrl}}{{authPath}}/otp/verify
Content-Type: application/json

{
  "phone": "+254721227443",
  "code": "822102"
}

### Begin Authenticator setup (requires JWT)
POST {{baseUrl}}{{authPath}}/authenticator/setup
Authorization: Bearer {{jwtToken}}

### Verify Authenticator token to finalize setup
POST {{baseUrl}}{{authPath}}/authenticator/verify
Authorization: Bearer {{jwtToken}}
Content-Type: application/json

{
  "token": "123456"
}

### Login using Authenticator (email + TOTP)
POST {{baseUrl}}{{authPath}}/authenticator/login
Content-Type: application/json

{
  "email": "antoh@test.gmail.com",
  "token": "123456"
}

### Request Password Reset
POST {{baseUrl}}{{authPath}}/password/reset-request
Content-Type: application/json

{
  "email": "antoh@test.gmail.com"
}

### Reset Password with Token
POST {{baseUrl}}{{authPath}}/password/reset
Content-Type: application/json

{
  "email": "antoh@test.gmail.com",
  "token": "4vs9pQZ3CgkOcVfXAPWiXswTLOYnNs7LPV6hppcEen9MYpEt",
  "newPassword": "NewSecurePassword123!"
}

### Get current profile (requires Authorization: Bearer <token>)
GET {{baseUrl}}{{authPath}}/profile
Authorization: Bearer {{jwtToken}}

##########################  DID AUTH TESTING ENDPOINTS   ###########################################################

### Request DID Auth Challenge
POST {{baseUrl}}{{authPath}}/did/challenge
Content-Type: application/json

{
  "did": "did:example:123456789abcdefghi"
}

### DID Auth Login
POST {{baseUrl}}{{authPath}}/did/login
Content-Type: application/json

{
  "did": "did:example:123456789abcdefghi",
  "jwt": "PASTE_SIGNED_JWT_HERE",
  "challengeId": "390bc3dc-c19f-4ffc-9d5e-9cd788b121b2"
}

