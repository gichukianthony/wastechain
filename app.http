############################### WASTE TESTING ENDPOINTS       ######################################################################

### Create Waste
POST {{baseUrl}}{{wastePath}}
Content-Type: application/json

{
  "type": "PLASTIC",
  "weight_kg": 2.5,
  "owner": "{{userId}}",
  "description": "Plastic bottles and containers"
}

### Get All Waste
GET {{baseUrl}}{{wastePath}}

### Get One Waste by ID
GET {{baseUrl}}{{wastePath}}/{{wasteId}}

### Update Waste (partial)
PATCH {{baseUrl}}{{wastePath}}/{{wasteId}}
Content-Type: application/json

{
  "weight_kg": 3.0,
  "description": "Updated description"
}

### Delete Waste
DELETE {{baseUrl}}{{wastePath}}/{{wasteId}}

#############################  WASTE REQUEST ENDPOINTS  ######################################################################

### Create Waste Request
POST {{baseUrl}}{{wastePath}}/requests
Content-Type: application/json

{
  "user": "{{userId}}",
  "waste_type": "PLASTIC",
  "status": "PENDING",
  "weight_kg": 1.5,
  "pickup_time": "2024-01-15T10:00:00Z"
}

### Get All Waste Requests
GET {{baseUrl}}{{wastePath}}/requests

### Get One Waste Request by ID
GET {{baseUrl}}{{wastePath}}/requests/{{wasteRequestId}}

### Update Waste Request (partial)
PATCH {{baseUrl}}{{wastePath}}/requests/{{wasteRequestId}}
Content-Type: application/json

{
  "status": "ASSIGNED",
  "weight_kg": 2.0,
  "collector":"{{userId}}"
}

### Delete Waste Request
DELETE {{baseUrl}}{{wastePath}}/requests/{{wasteRequestId}}

